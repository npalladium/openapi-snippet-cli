{
  "name": "@npalladium/openapi-snippet-cli",
  "version": "0.3.0",
  "description": "Adds openapi snippets using openapi-snippet in redoc style (x-codeSamples)",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "openapi-snippet": "dist/main.js"
  },
  "files": [
    "/dist"
  ],
  "license": "MIT",
  "author": "Nikhil Pallamreddy",
  "homepage": "https://github.com/npalladium/openapi-snippet-cli",
  "bugs": "https://github.com/npalladium/openapi-snippet-cli/issues",
  "repository": "npalladium/openapi-snippet-cli",
  "keywords": [
    "openapi",
    "swagger",
    "snippets",
    "openapi-snippets",
    "cli"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@npalladium/openapi-snippet-core": "workspace:*",
    "@stricli/core": "^1.2.7",
    "js-yaml": "^4.2.0",
    "openapi-types": "^12.1.3"
  },
  "optionalDependencies": {
    "redoc": "^2.5.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:js": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
    "build:bin": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist/main.js",
    "build": "pnpm build:js && pnpm build:bin",
    "prepack": "pnpm build",
    "dev": "tsx src/dev.ts",
    "test": "mocha"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.33"
  }
}
