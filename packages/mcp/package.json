{
  "name": "@npalladium/openapi-mcp",
  "version": "0.3.1",
  "description": "stdio MCP server exposing tools to explore an OpenAPI spec (with code snippets)",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "openapi-mcp": "dist/main.js"
  },
  "files": [
    "/dist"
  ],
  "license": "MIT",
  "author": "Nikhil Pallamreddy",
  "homepage": "https://github.com/npalladium/openapi-snippet-cli",
  "bugs": "https://github.com/npalladium/openapi-snippet-cli/issues",
  "repository": "npalladium/openapi-snippet-cli",
  "keywords": [
    "openapi",
    "swagger",
    "mcp",
    "model-context-protocol",
    "cli"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@npalladium/openapi-snippet-core": "workspace:*",
    "@stricli/core": "^1.2.7",
    "openapi-types": "^12.1.3",
    "zod": "^4.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:js": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
    "build:bin": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist/main.js",
    "build": "pnpm build:js && pnpm build:bin",
    "prepack": "pnpm build",
    "test": "mocha"
  },
  "devDependencies": {
    "@types/node": "^20.19.33"
  }
}
