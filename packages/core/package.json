{
  "name": "@openapi-snippet/core",
  "version": "0.3.0",
  "description": "Shared library for openapi-snippet: snippet generation, injection, spec loading, and HTML rendering",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "/dist"
  ],
  "license": "MIT",
  "author": "Nikhil Pallamreddy",
  "homepage": "https://github.com/npalladium/openapi-snippet-cli",
  "repository": "npalladium/openapi-snippet-cli",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@readme/openapi-parser": "^5.5.0",
    "httpsnippet": "^3.0.9",
    "js-yaml": "^4.2.0",
    "openapi-sampler": "^1.6.2",
    "openapi-types": "^12.1.3",
    "tslib": "^2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -b --emitDeclarationOnly && node scripts/fix-dts.mjs",
    "build:js": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
    "build": "pnpm build:types && pnpm build:js",
    "test": "mocha"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.33"
  }
}
