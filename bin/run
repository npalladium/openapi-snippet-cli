#!/usr/bin/env node

// Single-mode launcher: always invoke the compiled CLI in dist/.
// For dev (no dist yet), run `pnpm dev` instead — that uses tsx to
// run the TypeScript source directly.

process.env.NODE_ENV ??= 'production'

const { runMain } = await import(new URL('../dist/cli/index.js', import.meta.url))
await runMain()
