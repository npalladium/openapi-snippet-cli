{
  "name": "openapi-snippet-cli",
  "description": "Adds openapi snippets using openapi-snippet module in redoc style",
  "version": "0.2.1",
  "author": "Richard Kabiling",
  "bin": {
    "openapi-snippet": "./bin/run"
  },
  "type": "module",
  "bugs": "https://github.com/richardkabiling/openapi-snippet-cli/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^5",
    "@readme/openapi-parser": "^5.5.0",
    "httpsnippet": "^3.0.9",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.15",
    "openapi-sampler": "^1.6.2",
    "openapi-types": "^12.1.3",
    "tslib": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@tsconfig/node20": "^20.1.6",
    "@types/js-yaml": "^4",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10",
    "@types/node": "^20",
    "c8": "^10",
    "mocha": "^10",
    "oclif": "^4.22.81",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "/bin",
    "/dist"
  ],
  "homepage": "https://github.com/richardkabiling/openapi-snippet-cli",
  "keywords": [
    "openapi",
    "swagger",
    "snippets",
    "openapi-snippets",
    "cli"
  ],
  "license": "MIT",
  "main": "dist/cli/index.js",
  "oclif": {
    "bin": "openapi-snippet",
    "dirname": "openapi-snippet",
    "macos": {
      "identifier": "com.openapi-snippet-cli"
    },
    "commands": {
      "strategy": "single",
      "target": "./dist/cli/index.js"
    },
    "plugins": [
      "@oclif/plugin-help"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "repository": "richardkabiling/openapi-snippet-cli",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepack": "rm -rf dist && tsc -b",
    "pack:tarballs": "oclif pack tarballs",
    "pack:win": "oclif pack win",
    "pack:macos": "oclif pack macos",
    "pack:deb": "oclif pack deb",
    "test": "c8 mocha --forbid-only"
  },
  "types": "dist/cli/index.d.ts"
}
