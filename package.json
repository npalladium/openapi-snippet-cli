{
  "name": "openapi-snippet-cli",
  "description": "Adds openapi snippets using openapi-snippet module in redoc style",
  "version": "0.2.1",
  "author": "Nikhil Pallamreddy",
  "type": "module",
  "bin": {
    "openapi-snippet": "./bin/run"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "bugs": "https://github.com/npalladium/openapi-snippet-cli/issues",
  "dependencies": {
    "@readme/openapi-parser": "^5.5.0",
    "@stricli/core": "^1.2.7",
    "httpsnippet": "^3.0.9",
    "js-yaml": "^4.2.0",
    "openapi-sampler": "^1.6.2",
    "openapi-types": "^12.1.3",
    "tslib": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/js-yaml": "^4",
    "@types/mocha": "^10",
    "@types/node": "^20",
    "@typescript/native-preview": "7.0.0-dev.20260610.1",
    "c8": "^10",
    "esbuild": "^0.28.0",
    "mocha": "^10",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/bin",
    "/dist"
  ],
  "homepage": "https://github.com/npalladium/openapi-snippet-cli",
  "keywords": [
    "openapi",
    "swagger",
    "snippets",
    "openapi-snippets",
    "cli"
  ],
  "license": "MIT",
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "repository": "npalladium/openapi-snippet-cli",
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsgo --noEmit",
    "build:types": "tsc -b --emitDeclarationOnly",
    "build:js": "esbuild src/cli/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/cli/index.js",
    "build": "pnpm build:types && pnpm build:js",
    "dev": "tsx src/dev.ts",
    "test": "c8 mocha --forbid-only",
    "test:watch": "mocha --watch",
    "verify": "pnpm check && pnpm typecheck && pnpm build && pnpm test",
    "ci": "pnpm run verify",
    "prepack": "rm -rf dist && pnpm build"
  }
}
